rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isStaff() {
      return isAuthenticated() && 
        (getUserData().role in ['pathologist', 'technician', 'admin', 'physician']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || (isAuthenticated() && getUserData().role == 'admin');
      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }

    // Samples collection
    match /samples/{sampleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (getUserData().role in ['admin', 'pathologist']);
    }
  }
}
